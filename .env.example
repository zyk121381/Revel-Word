# AI Provider: Choose between 'openai' or 'gemini'
NEXT_PUBLIC_AI_PROVIDER="openai"

# OpenAI Configuration
NEXT_PUBLIC_OPENAI_API_KEY="MY_OPENAI_API_KEY"
# Optional: Custom API endpoint (for OpenAI-compatible services)
NEXT_PUBLIC_OPENAI_API_BASE="https://api.openai.com/v1"
# Optional: Model name
NEXT_PUBLIC_OPENAI_MODEL="gpt-4o-mini"

# Gemini Configuration (Alternative)
NEXT_PUBLIC_GEMINI_API_KEY="MY_GEMINI_API_KEY"
# Optional: Model name
NEXT_PUBLIC_GEMINI_MODEL="gemini-3.1-pro-preview"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"
