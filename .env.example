# AI Provider: Choose between 'openai' or 'gemini'
AI_PROVIDER="openai"

# OpenAI Configuration
OPENAI_API_KEY="MY_OPENAI_API_KEY"
# Optional: Custom API endpoint (for OpenAI-compatible services)
OPENAI_API_BASE="https://api.openai.com/v1"
# Optional: Model name
OPENAI_MODEL="gpt-4o-mini"

# Gemini Configuration (Alternative)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# Optional: Model name
GEMINI_MODEL="gemini-3.1-pro-preview"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

# Database Configuration (Optional)
# If set, enables user login, word units, and progress saving
DATABASE_URL=
# Example PostgreSQL: postgresql://user:password@localhost:5432/mydb
# Example MySQL: mysql://user:password@localhost:3306/mydb

# Admin Credentials (Required if DATABASE_URL is set)
# Used to log in as the initial administrator to create other users
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# JWT Secret for Session Management (Required if DATABASE_URL is set)
JWT_SECRET=your_super_secret_key_here
