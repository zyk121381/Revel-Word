# AI Provider: Choose between 'openai' or 'gemini'
# Default is 'openai' if not specified
AI_PROVIDER="openai"

# OpenAI Configuration
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY="your-openai-api-key-here"
# Optional: Custom API endpoint (for OpenAI-compatible services)
# Note: Don't include /chat/completions path, just base URL
# OPENAI_API_BASE="https://api.openai.com/v1"
# Optional: Model name (default: gpt-4o-mini)
# OPENAI_MODEL="gpt-4o-mini"

# Gemini Configuration (Alternative)
# Get your API key from https://makersuite.google.com/app/apikey
# GEMINI_API_KEY="your-gemini-api-key-here"
# Optional: Model name (default: gemini-3.1-pro-preview)
# GEMINI_MODEL="gemini-3.1-pro-preview"

# APP_URL: The URL where this applet is hosted
APP_URL="http://localhost:3000"
